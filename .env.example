# Environment Configuration Template
# COPY TO .env - NEVER COMMIT ACTUAL SECRETS OR .env TO GIT

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# Security & Authentication
SECRET_KEY=change_me_to_a_secure_random_string_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
CHALLENGE_SESSION_EXPIRE_SECONDS=60

# Model Paths & Configuration
PAD_MODEL_PATH=models/pad/minifasnet.onnx
PAD_MODEL_APPROVED=false
PAD_SCORE_THRESHOLD=0.90

EMBEDDING_MODEL_PATH=models/embedding/model.onnx
EMBEDDING_MODEL_APPROVED=false
EMBEDDING_DIMENSION=512
MATCH_SIMILARITY_THRESHOLD=0.65

# Storage & Indexing
DATABASE_URL=sqlite:///./face_rec.db
FAISS_INDEX_PATH=./storage/index.faiss
FAISS_MAPPING_PATH=./storage/mapping.json

# Ingestion Constraints
MAX_IMAGE_BYTES=524288
MAX_FRAMES_PER_REQUEST=5
MAX_IMAGE_DIMENSION=1920
